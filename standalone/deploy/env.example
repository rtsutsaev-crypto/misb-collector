# /etc/misb/env — настройки и ключи отдельной версии монитора МИСБ. Права 600, владелец root. В git НЕ класть.

# --- вход на сайт (HTTP Basic; пароль длинный, случайный)
MISB_USER=misb
MISB_PASSWORD=

# --- адрес сайта (для ссылки в итоговом сообщении сбора)
MISB_SITE_URL=https://monitor.example.ru

# --- модель через OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Основная модель ведёт сбор: нужна поддержка tools (вызов инструментов) и длинный контекст (от 200 тыс. токенов).
# Имя — как в каталоге https://openrouter.ai/models, например вида vendor/model. Выбор и цена — см. standalone/README.md.
OPENROUTER_MODEL=
# Дешёвая модель для чтения страниц (WebFetch) и поиска; пусто — та же, что основная.
OPENROUTER_PAGE_MODEL=
# Потолок расходов на один запуск, $ (при 90% агент дописывает итог и останавливается)
MISB_MAX_USD=3
MISB_MAX_TURNS=600
# Поиск в интернете (плагин web OpenRouter, платный за результаты): on | off
MISB_WEBSEARCH=on

# --- ключи источников (свои, не чужие). Пустой ключ — источники с ним пропускаются.
GOSPLAN_KEY=
TENDERGURU_KEY=
CHECKO_KEY=
DADATA_KEY=
# РосТендер Client API (ЛК: Профиль → Интеграции → API) и TenderLand (apiKey из ЛК)
ROSTENDER_KEY=
TENDERLAND_KEY=

# --- релей: на сервере в России не нужен (агент поднимает локальный). Внешний — только если сервер не в РФ.
RELAY_URL=
RELAY_TOKEN=

# --- пути (обычно не менять)
MISB_DB=/var/lib/misb/misb.sqlite3
MISB_LOG_DIR=/var/log/misb
MISB_WORK=/var/lib/misb/work
MISB_PORT=8080
